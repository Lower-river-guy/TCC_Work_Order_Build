# Copy to .env for local runs. Do not commit .env or real passwords.

# When set, every page and API route except /health and /api/config requires this token.
APP_ACCESS_TOKEN=

# T48 login used to reach TCC. The target device and project are chosen in the web UI.
TCC_T48_DEVICE_USER=
TCC_T48_DEVICE_PASS=
TCC_FTP_HOST=www.myconnectedsite.com
TCC_FTP_PORT=21
TCC_FTP_TIMEOUT=60

# Optional local KEY=VALUE file. Leave unset on Cloud Run and use environment variables.
# TCC_DEVICE_ENV_FILE=

MAX_UPLOAD_MB=200
PORT=8080
